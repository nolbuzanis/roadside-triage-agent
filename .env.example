# Roadside Triage Agent - Environment Variables
# Copy this file to .env and fill in the values

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# Twilio — Inbound Voice & SMS
# Purchase a phone number in the Twilio Console and configure the voice webhook:
#   Voice URL: https://<your-domain>/api/v1/twilio/voice  (POST)
#   Call status changes (status callback): https://<your-domain>/api/v1/twilio/status  (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Dispatcher SMS destination (cell number receiving new-ticket alerts)
DISPATCHER_ALERT_PHONE=

# Emergency transfer destination (911 or local emergency number)
EMERGENCY_TRANSFER_PHONE=
