# Roadside Triage Agent - Environment Variables
# Copy this file to .env and fill in the values

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=

# Twilio — Inbound Voice & SMS
# Purchase a phone number in the Twilio Console and configure the voice webhook:
#   Voice URL: https://<your-domain>/api/v1/twilio/voice  (POST)
#   Call status changes (status callback): https://<your-domain>/api/v1/twilio/status  (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Dispatcher SMS destination (cell number receiving new-ticket alerts)
DISPATCHER_ALERT_PHONE=

# Emergency transfer destination (911 or local emergency number)
EMERGENCY_TRANSFER_PHONE=
# Demo mode: hang up after the emergency message instead of transferring to
# EMERGENCY_TRANSFER_PHONE. Set to true for demos to avoid dialling a real
# emergency destination. Defaults to false (transfer).
EMERGENCY_HANGUP_INSTEAD_OF_TRANSFER=false

# Public demo sessions — keyed HMAC secret for phone matching (never a plain hash).
# Generate with: openssl rand -hex 32
DEMO_PHONE_HMAC_SECRET=
# Demo session lifetime in seconds (default 900 = 15 minutes). Bounds only
# starting the demo — a session must be unexpired to be claimed by a call.
DEMO_SESSION_TTL_SECONDS=900
# Claimed demo session lifetime in seconds (default 1800 = 30 minutes). On a
# successful claim the deadline becomes greatest(expires_at, now + this value),
# so browser access follows the claimed call instead of the creation clock.
# Must be a positive integer.
DEMO_CLAIMED_SESSION_TTL_SECONDS=1800

# Comma-separated browser origins allowed to call this API cross-origin
# (e.g. http://localhost:3000,https://<project-id>.web.app). Leave empty to
# deny all cross-origin browser requests.
FRONTEND_ORIGINS=
