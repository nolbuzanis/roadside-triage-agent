#!/bin/sh
#
# pre-push hook
# Rejects direct pushes to the `main` branch.
# All changes must go through a feature branch and pull request.

protected_branch='main'

while read local_ref local_sha remote_ref remote_sha; do
  # Extract the branch name from the ref (e.g. refs/heads/main -> main)
  branch=$(echo "$local_ref" | sed 's|refs/heads/||')

  if [ "$branch" = "$protected_branch" ]; then
    echo ""
    echo "ERROR: Direct push to '$protected_branch' is prohibited."
    echo ""
    echo "Please create a feature branch and open a pull request instead:"
    echo "  git checkout -b feat/your-description"
    echo "  git push origin feat/your-description"
    echo ""
    exit 1
  fi
done

exit 0
