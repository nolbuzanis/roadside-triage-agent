# Public Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Public Supabase anon/publishable key (Settings → API → anon/publishable)
# Never put the service-role key here or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=

# Backend base URL used by the demo session start flow
# (local: http://localhost:8000 — production: the Cloud Run service URL)
VITE_API_BASE_URL=

# Destination for the post-call "Send feedback" link in the demo UI
# (e.g. a feedback form URL — production: the VITE_FEEDBACK_URL repository variable)
# When unset, the link falls back to a same-page placeholder anchor.
VITE_FEEDBACK_URL=

# Google Analytics 4 measurement ID (e.g. G-QBJ3Z5Z8Y1)
# Production: the VITE_GA_MEASUREMENT_ID repository variable.
# When unset, analytics is disabled and no tracking requests are sent.
VITE_GA_MEASUREMENT_ID=
