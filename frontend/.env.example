# Public Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=

# Public Supabase anon/publishable key (Settings → API → anon/publishable)
# Never put the service-role key here or anywhere in the frontend.
VITE_SUPABASE_ANON_KEY=

# Backend base URL used by the demo session start flow
# (local: http://localhost:8000 — production: the Cloud Run service URL)
VITE_API_BASE_URL=
